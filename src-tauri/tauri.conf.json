{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kaiso",
  "version": "0.1.0",
  "identifier": "com.iaust.kaiso",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kaiso",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 450,
        "decorations": false,
        "backgroundColor": "#18181b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../model_exporter/mobileclip2-b/vision_model.onnx": "models/vision_model.onnx",
      "../model_exporter/mobileclip2-b/text_model.onnx": "models/text_model.onnx",
      "../model_exporter/mobileclip2-b/tokenizer.json": "models/tokenizer.json",
      "../model_exporter/blip_itm_base_coco/blip_vision.onnx": "models/blip_vision.onnx",
      "../model_exporter/blip_itm_base_coco/blip_itm.onnx": "models/blip_itm.onnx",
      "../model_exporter/blip_itm_base_coco/blip_tokenizer.json": "models/blip_tokenizer.json"
    }
  }
}