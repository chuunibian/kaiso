{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kaiso",
  "version": "0.1.0",
  "identifier": "com.iaust.kaiso",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kaiso",
        "width": 800,
        "height": 600,
        "decorations": false,
        "backgroundColor": "#18181b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../model_exporter/clip_onnx_mobile/vision_model.onnx": "models/vision_model.onnx",
      "../model_exporter/clip_onnx_mobile/text_model.onnx": "models/text_model.onnx",
      "../model_exporter/clip_onnx_mobile/tokenizer.json": "models/tokenizer.json"
    }
  }
}